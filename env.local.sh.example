# Copy to env.local.sh (git ignores it) and adjust. env.sh sources it.
# Do not change the pinned versions here unless you mean to measure something else.

# A short name for your machine; results are filed under results/<MACHINE_ID>/.
# export MACHINE_ID=macbook-pro-m3-pro-36gb

# Executor size. Keep it the same for every run you compare.
# export CORES=8
# export EXEC_MEM=16g
# export OFFHEAP=16g
# export WORKER_MEM=40g     # >= EXEC_MEM + OFFHEAP + headroom

# Reuse things you already have instead of downloading them into deps/.
# export SPARK_HOME=$HOME/opt/spark-4.1.3-bin-hadoop3
# export ASPROF_HOME=$HOME/opt/async-profiler

# Your own Comet checkout. The scripts never change its git state, but the numbers are
# only comparable if it is at COMET_REF and built with `make release`.
# export COMET_HOME=$HOME/src/datafusion-comet

# Or an existing Comet jar, skipping the build entirely.
# export COMET_JAR=/path/to/comet-spark-spark4.1_2.13-<version>.jar

# Optional native allocator for a source build: mimalloc (or jemalloc via PROFILES).
# Published Linux jars use the system allocator; leave empty to match them.
# export COMET_FEATURES=mimalloc
